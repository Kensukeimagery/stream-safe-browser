{
  "manifest_version": 3,
  "name": "Stream-safe Check",
  "version": "1.2.0",
  "description": "Tells you whether hardware DRM will make Discord screen share go black, and how to fix it without turning off GPU acceleration.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Stream-safe Check",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://*.netflix.com/*",
        "https://*.disneyplus.com/*",
        "https://*.hulu.com/*",
        "https://*.primevideo.com/*",
        "https://*.max.com/*",
        "https://*.hbomax.com/*",
        "https://*.paramountplus.com/*",
        "https://*.peacocktv.com/*",
        "https://*.crunchyroll.com/*",
        "https://*.viu.com/*",
        "https://*.hotstar.com/*",
        "https://*.tv.apple.com/*",
        "https://*.discoveryplus.com/*",
        "https://*.skyshowtime.com/*",
        "https://*.wetv.vip/*",
        "https://*.iq.com/*",
        "https://*.vidio.com/*",
        "https://*.mubi.com/*",
        "https://*.sling.com/*",
        "https://*.starz.com/*",
        "https://*.showtime.com/*",
        "https://*.britbox.com/*",
        "https://*.tving.com/*",
        "https://*.wavve.com/*",
        "https://*.jiocinema.com/*",
        "https://*.zee5.com/*",
        "https://*.sonyliv.com/*",
        "https://*.stan.com.au/*",
        "https://*.crave.ca/*",
        "https://*.canalplus.com/*"
      ],
      "js": ["probe.js", "banner.js"],
      "run_at": "document_idle"
    }
  ]
}
